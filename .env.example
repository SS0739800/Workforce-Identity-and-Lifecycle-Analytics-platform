# Copy to .env and adjust. .env is git-ignored.

# Used by docker-compose to initialise the local PostgreSQL container
POSTGRES_USER=workforce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workforce
POSTGRES_PORT=5432

# Used by the application, Alembic and the load script
DATABASE_URL=postgresql+psycopg://workforce:change-me@localhost:5432/workforce

# Separate database used by the integration tests (created by docker/postgres/init-test-db.sql)
TEST_DATABASE_URL=postgresql+psycopg://workforce:change-me@localhost:5432/workforce_test

# Read-only login Power BI uses to read the reporting views (scripts/create_reporting_user.py)
REPORTING_DB_USER=powerbi_reader
REPORTING_DB_PASSWORD=change-me-too

# Groq (optional). The AI endpoints still return computed data without it.
# Check https://console.groq.com/docs/models for current production models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (optional): used when Groq can't answer, e.g. when its token quota runs out.
# Check https://ai.google.dev/gemini-api/docs/models for current models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LOG_LEVEL=INFO

# Streamlit console: where the FastAPI backend is running
API_BASE_URL=http://127.0.0.1:8000

# Azure deployment only (scripts/azure_deploy.py, see docs/azure.md). The app doesn't read these.
# Neon connection string, as Neon shows it (postgresql://...?sslmode=require)
NEON_DATABASE_URL=
# GitHub user and a classic token with only the read:packages scope, to pull the private image
GHCR_USERNAME=
GHCR_READ_TOKEN=
