	measure 'First-Time Offboarding Success Rate' = ```
			
			        VAR FirstAttempts =
			            CALCULATE (
			                [Workflow Count],
			                fact_workflow_runs[workflow_type] = "offboarding",
			                fact_workflow_runs[is_rerun] = FALSE (),
			                fact_workflow_runs[status] IN { "completed", "failed" }
			            )
			        VAR Succeeded =
			            CALCULATE (
			                [Workflow Count],
			                fact_workflow_runs[workflow_type] = "offboarding",
			                fact_workflow_runs[is_rerun] = FALSE (),
			                fact_workflow_runs[status] = "completed"
			            )
			        RETURN
			            DIVIDE ( Succeeded, FirstAttempts )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a70111de-6c59-41c1-8ff3-49d68acf0ee0

